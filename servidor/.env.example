# Copie para servidor/.env e preencha. NÃO versione o .env.

# Banco atual (mesmo container e volume). O monitor usa só o schema "monitor".
# Use a mesma senha do usuário cftv que está no .env do compose atual.
DATABASE_URL=postgresql://cftv:TROQUE_A_SENHA@potencial-cftv-db:5432/potencial_cftv
DB_SCHEMA=monitor

# Chave das senhas dos DVRs (Fernet). Gere UMA vez e guarde em local seguro:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
# Se perder ou trocar a chave, as senhas cadastradas precisam ser digitadas de novo.
CFTV_SECRET_KEY=

# Tokens da API (gere com: openssl rand -hex 32). ADMIN altera; READ só consulta.
API_ADMIN_TOKEN=
API_READ_TOKEN=
ALLOW_ANONYMOUS_READ=false

# Painel na Vercel (separe por vírgula)
CORS_ORIGINS=https://cftv-potencial.vercel.app

# Mesmo webhook já usado hoje
SLACK_WEBHOOK_URL=

# Sistema atual, para importar lojas/DVRs/canais
LEGACY_API_URL=http://192.168.0.46:8095

MONITOR_ENABLED=true
DISPLAY_TZ=America/Sao_Paulo
LOG_LEVEL=INFO
