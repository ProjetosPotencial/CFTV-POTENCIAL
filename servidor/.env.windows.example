# Copie para servidor/.env.windows e preencha. NÃO versione o arquivo preenchido.
# O banco é criado sozinho pelo compose.windows.yml (não precisa de DATABASE_URL aqui).
DB_SCHEMA=monitor

# Chave das senhas dos DVRs (Fernet). Gere UMA vez e guarde em local seguro:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'"
CFTV_SECRET_KEY=

# Tokens da API (qualquer texto longo e aleatório). ADMIN altera; READ só consulta.
API_ADMIN_TOKEN=
API_READ_TOKEN=
ALLOW_ANONYMOUS_READ=false

CORS_ORIGINS=https://cftv-potencial.vercel.app,http://localhost:8096
SLACK_WEBHOOK_URL=

SEED_INVENTORY=true
MONITOR_ENABLED=true
DISPLAY_TZ=America/Sao_Paulo
LOG_LEVEL=INFO
